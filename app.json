{
  "expo": {
    "name": "WordWise",
    "slug": "vocab",
    "scheme": "wordwise",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#378ADD"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wordwise.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.wordwise.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#378ADD"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-router", "expo-audio"],
    "extra": {
      "privacyPolicyUrl": "https://pcollinx.github.io/wordwise-privacy/"
    }
  }
}
