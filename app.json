{
  "expo": {
    "name": "WordWise",
    "slug": "vocab",
    "scheme": "wordwise",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#378ADD"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wordwise.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.wordwise.app",

      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#378ADD"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-audio",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.549372255118-0dh043d953silcnikfn2lddcmlabp2fa"
        }
      ],
      "./plugins/withGoogleServices",
      [
        "@sentry/react-native/expo",
        {
          "organization": "collins-sb",
          "project": "wordwise"
        }
      ]
    ],
    "extra": {
      "privacyPolicyUrl": "https://pcollinx.github.io/wordwise-privacy/",
      "router": {},
      "eas": {
        "projectId": "d7e58008-8518-475b-8c3e-e674eb1d6563"
      }
    }
  }
}
